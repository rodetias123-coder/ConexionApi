@{
    ViewData["Title"] = "Explorador de contenido aleatorio";
}

<div class="text-center mb-4">
    <h1 class="display-5">Explorador de contenido aleatorio</h1>
    <p class="text-muted">Cuatro APIs públicas, cuatro secciones independientes.</p>
</div>

<div class="row g-4">

    <!-- Citas -->
    <div class="col-12 col-md-6">
        <div class="card h-100 seccion-tarjeta">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title h5">Citas y autores</h2>
                <div id="citaContenido" class="contenido-seccion flex-grow-1">
                    <blockquote class="blockquote mb-2">
                        <p id="citaTexto">—</p>
                    </blockquote>
                    <footer class="blockquote-footer" id="citaAutor">—</footer>
                </div>
                <p id="citaEstado" class="estado-seccion" role="status" aria-live="polite"></p>
                <button id="btnCita" type="button" class="btn btn-primary mt-2">Obtener otra cita</button>
            </div>
        </div>
    </div>

    <!-- Perros -->
    <div class="col-12 col-md-6">
        <div class="card h-100 seccion-tarjeta">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title h5">Imágenes de perros</h2>
                <div id="perroContenido" class="contenido-seccion flex-grow-1 text-center">
                    <img id="perroImagen" class="imagen-uniforme" src="" alt="Perro aleatorio" hidden />
                </div>
                <p id="perroEstado" class="estado-seccion" role="status" aria-live="polite"></p>
                <button id="btnPerro" type="button" class="btn btn-primary mt-2">Mostrar otro perro</button>
            </div>
        </div>
    </div>

    <!-- Gatos -->
    <div class="col-12 col-md-6">
        <div class="card h-100 seccion-tarjeta">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title h5">Imágenes de gatos</h2>
                <div id="gatoContenido" class="contenido-seccion flex-grow-1 text-center">
                    <img id="gatoImagen" class="imagen-uniforme" src="" alt="Gato aleatorio" hidden />
                </div>
                <p id="gatoEstado" class="estado-seccion" role="status" aria-live="polite"></p>
                <button id="btnGato" type="button" class="btn btn-primary mt-2">Mostrar otro gato</button>
            </div>
        </div>
    </div>

    <!-- Datos curiosos -->
    <div class="col-12 col-md-6">
        <div class="card h-100 seccion-tarjeta">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title h5">Datos curiosos</h2>
                <div id="datoContenido" class="contenido-seccion flex-grow-1">
                    <p id="datoTexto">—</p>
                </div>
                <p id="datoEstado" class="estado-seccion" role="status" aria-live="polite"></p>
                <button id="btnDato" type="button" class="btn btn-primary mt-2">Mostrar otro dato</button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/explorador.js" asp-append-version="true"></script>
}
